# PolarSense Ground Station & Telemetry Credentials
# COPY THIS FILE TO .env AND FILL WITH LOCAL TESTING VALUES
# DO NOT COMMIT THE REAL .env FILE TO VERSION CONTROL

# 32-Byte Secret Key for HMAC-SHA-256 Frame Authentication (Hex or ASCII)
POLARSENSE_HMAC_KEY=placeholder_hmac_secret_key_32_bytes_test_only!

# Database Configuration:
# Leave POLARSENSE_DATABASE_URL empty to use automatic embedded SQLite fallback.
# For production PostgreSQL + TimescaleDB, provide full connection string:
# POLARSENSE_DATABASE_URL=postgresql://user:password@localhost:5432/polarsense

# Iridium DirectIP / SBD Ingest Settings (Optional)
IRIDIUM_IMEI_WHITELIST=300434060000001,300434060000002
IRIDIUM_DIRECTIP_PORT=10800
